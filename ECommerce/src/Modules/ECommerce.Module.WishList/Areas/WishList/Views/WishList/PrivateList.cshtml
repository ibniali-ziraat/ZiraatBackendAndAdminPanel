@using cloudscribe.Web.Pagination
@model ECommerce.Module.WishList.Areas.WishList.ViewModels.WishListVm
@{
    ViewData["Title"] = Localizer["Wish List"];
    ViewData["HideChrome"] = true;
}

@section head {
    <link simpl-append-version="true" rel="stylesheet" href="~/_content/ECommerce.Module.WishList/private-list.css" />
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Saved products"]</span>
                    <h1>@Localizer["Wish List"]</h1>
                    <p>@Localizer["Review saved products, update quantities, and move favorites into your cart."]</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Items"]</span>
                    <strong>@Model.Items.TotalItems</strong>
                    <small>@Localizer["Products saved for later appear below."]</small>
                </div>
            </section>

            <section class="acct-form-panel wishlist">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Wishlist"]</span>
                        <h2>@Localizer["Wish List"]</h2>
                    </div>
                    <a class="acct-secondary-action" asp-area="WishList" asp-controller="WishList" asp-action="Share">@Localizer["Share Wish List"]</a>
                </div>

                @if (Model.Items.TotalItems > 0)
                {
                    <div class="acct-wishlist-list">
                    @foreach (var item in Model.Items.Data)
                    {
                        <article class="acct-wishlist-item">
                            <img alt="@item.ProductName" src="@item.ProductImage">
                            <div class="acct-wishlist-item__body">
                                <h3>@item.ProductName</h3>
                                <form>
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <div class="acct-form-grid">
                                        <div class="acct-field">
                                            <label>@Localizer["Quantity"]</label>
                                            <input type="number" name="qty" class="form-control quantity-field" value="@item.Quantity" min="1" />
                                        </div>
                                        <div class="acct-field">
                                            <label>@Localizer["Description"]</label>
                                            <textarea name="description" class="form-control" rows="2">@item.Description</textarea>
                                        </div>
                                    </div>
                                    <div class="acct-inline-actions">
                                        <button type="button" class="acct-primary-action btn-add-cart">@Localizer["Add to cart"]</button>
                                        <button type="button" class="acct-card-link update-wishlist">@Localizer["Update"]</button>
                                        <button type="button" class="acct-danger-action remove-from-wishlist">@Localizer["Remove"]</button>
                                    </div>
                                </form>
                            </div>
                        </article>
                    }
                    </div>

                    <div class="acct-pager-row">
                        <div>
                            <cs-pager cs-paging-pagesize="@Model.Items.PageSize"
                                      cs-paging-pagenumber="@Model.Items.PageNumber"
                                      cs-paging-totalitems="@Model.Items.TotalItems"
                                      cs-pagenumber-param="pageNumber"
                                      asp-controller="WishList"
                                      asp-action="PrivateList"
                                      asp-route-id="@Model.Id"
                                      asp-route-pageSize="@Model.Items.PageSize"
                                      cs-pager-li-current-class="page-item active"
                                      cs-pager-li-other-class="page-item"
                                      cs-pager-li-non-active-class="page-item disabled"
                                      cs-pager-link-current-class="page-link"
                                      cs-pager-link-other-class="page-link"></cs-pager>
                        </div>
                    </div>
                }
                else
                {
                    <p class="acct-empty-state">@Localizer["There are currently no items in your wish list."]</p>
                }
            </section>
        </main>
    </div>
</div>
