@model ECommerce.Module.Orders.Areas.Orders.ViewModels.OrderDetailVm

@{
    ViewData["Title"] = Localizer["Order detail"];
    ViewData["HideChrome"] = true;
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Order"] #@Model.Id</span>
                    <h1>@Localizer[Model.OrderStatusString]</h1>
                    <p>@Localizer["Order date"] @Model.CreatedOn.DateTime</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Order total"]</span>
                    <strong>@Model.OrderTotalString</strong>
                    <small>@Localizer["Includes shipping, taxes, discounts, and payment fees."]</small>
                </div>
            </section>

            <section class="acct-form-panel acct-order-detail">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Fulfillment"]</span>
                        <h2>@ViewData["Title"]</h2>
                    </div>
                    <a href="~/user/orders" class="acct-secondary-action">@Localizer["Back to orders"]</a>
                </div>

                <div class="acct-detail-grid">
                    <div>
                        <span class="acct-card-label">@Localizer["Shipping address"]</span>
                        <strong>@Model.ShippingAddress.ContactName</strong>
                        <p>@Model.ShippingAddress.AddressLine1<br />@Model.ShippingAddress.AddressLine2<br />@Localizer["Phone"]: @Model.ShippingAddress.Phone</p>
                    </div>
                    <div>
                        <span class="acct-card-label">@Localizer["Shipping method"]</span>
                        <strong>@Model.ShippingMethod</strong>
                    </div>
                    <div>
                        <span class="acct-card-label">@Localizer["Payment method"]</span>
                        <strong>@Localizer[Model.PaymentMethod]</strong>
                    </div>
                </div>

                <div class="acct-table-wrap">
                    <table class="acct-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Product"]</th>
                                <th>@Localizer["Price"]</th>
                                <th>@Localizer["Quantity"]</th>
                                <th>@Localizer["Discount"]</th>
                                <th>@Localizer["Row Total"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="acct-product-mini acct-product-mini--large">
                                            <img src="@item.ProductImage" alt="@item.ProductName" />
                                            <div>
                                                <strong>@item.ProductName</strong>
                                                <span>@Localizer["Quantity"] @item.Quantity</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.ProductPriceString</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.DiscountAmountString</td>
                                    <td class="acct-strong">@item.RowTotalString</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="acct-total-panel">
                    <div><span>@Localizer["Subtotal"]</span><strong>@Model.SubtotalString</strong></div>
                    <div><span>@Localizer["Shipping"]</span><strong>@Model.ShippingAmountString</strong></div>
                    <div><span>@Localizer["Tax"]</span><strong>@Model.TaxAmountString</strong></div>
                    <div><span>@Localizer["Discount"]</span><strong>@Model.DiscountAmountString</strong></div>
                    <div><span>@Localizer["Payment Fee"]</span><strong>@Model.PaymentFeeAmountString</strong></div>
                    <div class="acct-total-panel__grand"><span>@Localizer["Order Total"]</span><strong>@Model.OrderTotalString</strong></div>
                </div>
            </section>
        </main>
    </div>
</div>
