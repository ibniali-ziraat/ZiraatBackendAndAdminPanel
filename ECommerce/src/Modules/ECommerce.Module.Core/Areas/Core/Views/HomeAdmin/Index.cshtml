                                                                                                                                                            }

                                                                                                                                                            var setGroupExpandedState = function (group, isExpanded) {
                                                                                                                                                            var trigger = group.querySelector('[data-admin-nav-trigger]');
                                                                                                                                                            var items = group.querySelector('[data-admin-nav-items]');

                                                                                                                                                            group.classList.toggle('is-collapsed', !isExpanded);

                                                                                                                                                            if (trigger) {
                                                                                                                                                            trigger.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                                                                                                                                                            }

                                                                                                                                                            if (items) {
                                                                                                                                                            items.hidden = !isExpanded;
                                                                                                                                                            }
                                                                                                                                                            };

                                                                                                                                                            var openActiveGroups = function () {
                                                                                                                                                            Array.prototype.forEach.call(navGroups, function (group) {
                                                                                                                                                            if (group.querySelector('a.is-active, a.ui-sref-active, a.ui-sref-active-eq')) {
                                                                                                                                                            setGroupExpandedState(group, true);
                                                                                                                                                            }
                                                                                                                                                            });
                                                                                                                                                            };

                                                                                                                                                            Array.prototype.forEach.call(navGroups, function (group) {
                                                                                                                                                            var trigger = group.querySelector('[data-admin-nav-trigger]');

                                                                                                                                                            setGroupExpandedState(group, false);

                                                                                                                                                            if (!trigger) {
                                                                                                                                                            return;
                                                                                                                                                            }

                                                                                                                                                            trigger.addEventListener('click', function () {
                                                                                                                                                            setGroupExpandedState(group, group.classList.contains('is-collapsed'));
                                                                                                                                                            });
                                                                                                                                                            });

                                                                                                                                                            var setExpandedState = function (isOpen) {
                                                                                                                                                            body.classList.toggle('admin-nav-open', isOpen);
                                                                                                                                                            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                                                                                                                                                            };

                                                                                                                                                            toggle.addEventListener('click', function () {
                                                                                                                                                            setExpandedState(!body.classList.contains('admin-nav-open'));
                                                                                                                                                            });

                                                                                                                                                            Array.prototype.forEach.call(closeItems, function (item) {
                                                                                                                                                            item.addEventListener('click', function () {
                                                                                                                                                            window.setTimeout(openActiveGroups, 0);

                                                                                                                                                            if (window.innerWidth < 992) {
                                                                                                                                                            setExpandedState(false);
                                                                                                                                                            }
                                                                                                                                                            });
                                                                                                                                                            });

                                                                                                                                                            openActiveGroups();

                                                                                                                                                            window.addEventListener('resize', function () {
                                                                                                                                                            if (window.innerWidth >= 992) {
                                                                                                                                                            setExpandedState(false);
                                                                                                                                                            }
                                                                                                                                                            });
                                                                                                                                                            }());
                                                                                                                                                        </script>
                                                                                                                                                        <script simpl-append-version="true" src="~/js/button-icons.js"></script>
                                                                                                                                                    </body>

                                                                                                                                                </html>
