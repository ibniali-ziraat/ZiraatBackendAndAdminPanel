@model ECommerce.Module.Core.Areas.Core.ViewModels.UserAddressFormViewModel
@{
    ViewData["Title"] = Localizer["Edit address"];
    ViewData["HideChrome"] = true;
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Shipping"]</span>
                    <h1>@Localizer["Edit Address"]</h1>
                    <p>@Localizer["Update delivery and contact details for this saved address."]</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Saved address"]</span>
                    <strong>@Localizer["Keep it current"]</strong>
                    <small>@Localizer["Changes are used by your address book and checkout flow."]</small>
                </div>
            </section>

            <section class="acct-form-panel">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Address form"]</span>
                        <h2>@Localizer["Edit Address"]</h2>
                    </div>
                    <a href="~/user/address" class="acct-secondary-action">@Localizer["Back to addresses"]</a>
                </div>
                <form asp-area="Core" asp-controller="UserAddress" asp-action="Edit" method="POST" class="acct-modern-form">
                    <partial name="_AddressForm" model="Model" />
                </form>
            </section>
        </main>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/_content/ECommerce.Module.Core/user-address.js"></script>
}
