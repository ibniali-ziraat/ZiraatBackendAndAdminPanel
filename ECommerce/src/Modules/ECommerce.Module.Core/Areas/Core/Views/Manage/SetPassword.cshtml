@model SetPasswordViewModel
@{
    ViewData["Title"] = Localizer["Set Password"];
    ViewData["HideChrome"] = true;
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Security"]</span>
                    <h1>@Localizer["Set Password"]</h1>
                    <p>@Localizer["Add a local password so this account can sign in without an external login provider."]</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Local access"]</span>
                    <strong>@Localizer["Create password"]</strong>
                    <small>@Localizer["This adds a username/password option to your current account."]</small>
                </div>
            </section>

            <section class="acct-form-panel">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Credentials"]</span>
                        <h2>@Localizer["Set your password"]</h2>
                    </div>
                    <a href="~/user" class="acct-secondary-action">@Localizer["Back to dashboard"]</a>
                </div>

                <p class="acct-note">
                    @Localizer["You do not have a local username/password for this site. Add a local account so you can log in without an external login."]
                </p>
                <form asp-area="Core" asp-controller="Manage" asp-action="SetPassword" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="acct-modern-form">
                    <div asp-validation-summary="All" class="acct-validation-summary"></div>
                    <div class="acct-form-grid">
                        <div class="acct-field">
                            <label asp-for="NewPassword"></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="acct-field">
                            <label asp-for="ConfirmPassword"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="acct-form-actions">
                        <button type="submit" class="acct-primary-action">@Localizer["Set password"]</button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
