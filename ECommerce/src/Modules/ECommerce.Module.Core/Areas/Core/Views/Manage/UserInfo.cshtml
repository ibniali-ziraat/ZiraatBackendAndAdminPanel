@model UserInfoVm
@{
    ViewData["Title"] = Localizer["Account Information"];
    ViewData["HideChrome"] = true;
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Profile details"]</span>
                    <h1>@Localizer["Account Information"]</h1>
                    <p>@Localizer["Keep your customer profile clear and current so orders, support, and notifications stay connected to the right person."]</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Current email"]</span>
                    <strong>@Model.Email</strong>
                    <small>@Localizer["Email is used for sign-in and account communication."]</small>
                </div>
            </section>

            <section class="acct-form-panel">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Editable profile"]</span>
                        <h2>@Localizer["Personal details"]</h2>
                    </div>
                    <a href="~/user" class="acct-secondary-action">@Localizer["Back to dashboard"]</a>
                </div>

                <form asp-area="Core" asp-controller="Manage" asp-action="UserInfo" method="post" role="form" class="acct-modern-form">
                    <div asp-validation-summary="All" class="acct-validation-summary"></div>

                    <div class="acct-form-grid">
                        <div class="acct-field">
                            <label asp-for="Email">@Localizer["Email"]</label>
                            <input asp-for="Email" readonly class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="acct-field">
                            <label asp-for="FullName">@Localizer["FullName"]</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="acct-form-actions">
                        <button type="submit" class="acct-primary-action">@Localizer["Save"]</button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
