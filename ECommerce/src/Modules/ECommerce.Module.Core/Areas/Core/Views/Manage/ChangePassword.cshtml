@model ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["Change Password"];
    ViewData["HideChrome"] = true;
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Security"]</span>
                    <h1>@Localizer["Change Password"]</h1>
                    <p>@Localizer["Update your local account password to keep access protected."]</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Password update"]</span>
                    <strong>@Localizer["Use a strong password"]</strong>
                    <small>@Localizer["Your session stays signed in after a successful change."]</small>
                </div>
            </section>

            <section class="acct-form-panel">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Credentials"]</span>
                        <h2>@Localizer["Change Password Form"]</h2>
                    </div>
                    <a href="~/user" class="acct-secondary-action">@Localizer["Back to dashboard"]</a>
                </div>

                <form asp-area="Core" asp-controller="Manage" asp-action="ChangePassword" method="post" class="acct-modern-form">
                    <div asp-validation-summary="All" class="acct-validation-summary"></div>
                    <div class="acct-form-grid acct-form-grid--single">
                        <div class="acct-field">
                            <label asp-for="OldPassword"></label>
                            <input asp-for="OldPassword" class="form-control" />
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>
                        <div class="acct-field">
                            <label asp-for="NewPassword"></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="acct-field">
                            <label asp-for="ConfirmPassword"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="acct-form-actions">
                        <button type="submit" class="acct-primary-action">@Localizer["Change password"]</button>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
