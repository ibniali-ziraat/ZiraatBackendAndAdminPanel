@model UserSettingViewModel
@{
    ViewData["Title"] = Localizer["My Settings"];
    ViewData["HideChrome"] = true;
    var visibleSettings = Model.SettingDefinitions.Values.Where(x => x.IsVisibleToClients).ToList();
}

<div class="acct-shell acct-shell--dashboard">
    <div class="acct-body acct-body--dashboard">
        <partial name="_AccountMenu" />

        <main class="acct-content acct-dashboard">
            <section class="acct-dashboard-hero acct-dashboard-hero--compact">
                <div class="acct-dashboard-hero__copy">
                    <span class="acct-kicker">@Localizer["Preferences"]</span>
                    <h1>@ViewData["Title"]</h1>
                    <p>@Localizer["Adjust account-specific settings available for your storefront experience."]</p>
                </div>
                <div class="acct-dashboard-hero__panel">
                    <span>@Localizer["Settings"]</span>
                    <strong>@visibleSettings.Count</strong>
                    <small>@Localizer["Visible settings can be updated below."]</small>
                </div>
            </section>

            <section class="acct-form-panel">
                <div class="acct-form-panel__header">
                    <div>
                        <span class="acct-card-label">@Localizer["Account preferences"]</span>
                        <h2>@ViewData["Title"]</h2>
                    </div>
                    <a href="~/user" class="acct-secondary-action">@Localizer["Back to dashboard"]</a>
                </div>

                <form asp-area="Core" asp-controller="Manage" asp-action="UserSettings" method="post" role="form" class="acct-modern-form">
                    <div asp-validation-summary="All" class="acct-validation-summary"></div>
                    @if (visibleSettings.Any())
                    {
                        <div class="acct-form-grid acct-form-grid--single">
                            @foreach (var item in visibleSettings)
                            {
                                <div class="acct-field">
                                    <label asp-for="UserSettings[item.Name]">@(item.DisplayName ?? Localizer[item.Name].Value)</label>
                                    <input asp-for="UserSettings[item.Name]" class="form-control" placeholder="@Localizer["Default Value"]: @item.DefaultValue" />
                                    <span asp-validation-for="UserSettings[item.Name]" class="text-danger"></span>
                                </div>
                            }
                        </div>
                        <div class="acct-form-actions">
                            <button type="submit" class="acct-primary-action">@Localizer["Save"]</button>
                        </div>
                    }
                    else
                    {
                        <p class="acct-empty-state">@Localizer["No settings available."]</p>
                    }
                </form>
            </section>
        </main>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
