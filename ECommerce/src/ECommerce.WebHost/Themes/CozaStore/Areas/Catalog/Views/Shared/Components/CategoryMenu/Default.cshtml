@model IEnumerable<ECommerce.Module.Catalog.Areas.Catalog.ViewModels.CategoryMenuItem>

@inject IViewLocalizer Localizer

@foreach (var item in Model)
{
    if (item.ChildItems.Any())
    {
        <li class="nav-item invenzo-nav-item invenzo-has-children">
            <a href="/@item.Slug" class="nav-link invenzo-nav-link">@item.Name</a>
            <ul class="sub-menu sub-menu-m invenzo-submenu">
                @foreach (var childItem in item.ChildItems)
                {
                    <li class="invenzo-submenu-item"><a href="/@childItem.Slug" class="invenzo-submenu-link">@childItem.Name</a></li>
                }
            </ul>
            <span class="arrow-main-menu-m d-md-none">
                <i class="fa fa-angle-right" aria-hidden="true"></i>
            </span>
        </li>
    }
    else
    {
        <li class="nav-item invenzo-nav-item"><a href="/@item.Slug" class="nav-link invenzo-nav-link">@item.Name</a></li>
    }
}
