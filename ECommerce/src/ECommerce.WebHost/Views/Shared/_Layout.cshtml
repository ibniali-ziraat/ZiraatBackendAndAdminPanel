@using System.Globalization

@{
    var hideChrome = ViewData["HideChrome"] as bool? == true;
}

<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.Name.ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="theme-color" content="#16a34a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="ECommerce">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>@ViewData["Title"] - Ecommerce</title>
    @RenderSection("additionalMeta", false)

    <!-- Modern Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/themes/CozaStore/images/icons/logo-01.png">

    <link simpl-append-version="true" rel="stylesheet" href="~/libs.min.css" />
    <link simpl-append-version="true" rel="stylesheet" href="~/themes/CozaStore/css/green-white-theme.css" />
    <link simpl-append-version="true" rel="stylesheet" href="~/themes/CozaStore/css/animations.css" />
    <link simpl-append-version="true" rel="stylesheet" href="~/themes/CozaStore/css/responsive.css" />
    <link simpl-append-version="true" rel="stylesheet" href="~/themes/CozaStore/css/invenzo-refresh.css" />
    <link simpl-append-version="true" rel="stylesheet" href="~/_content/ECommerce.Module.Core/site.css" />
    <script simpl-append-version="true" src="~/lib/angular/angular.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.min.js"
            integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
            crossorigin="anonymous"></script>

    @RenderSection("head", required: false)
</head>
<body class="glass-theme @(hideChrome ? "account-auth-shell" : string.Empty)">
    <!-- Animated Background -->
    @if (!hideChrome)
    {
        <div class="bg-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>
    }

    <!-- Top Bar -->
    @if (!hideChrome)
    {
    <div class="top-bar-glass">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="contact-info d-none d-md-block">
                <span><i class="fas fa-envelope mr-2"></i> support@ecommerce.com</span>
                <span class="ml-4"><i class="fas fa-phone mr-2"></i> +1 234 567 8900</span>
            </div>
            <ul class="nav top-nav-links justify-content-end align-items-center">
                <partial name="_SelectLanguagePartial" />
                <partial name="_LoginPartial" />
            </ul>
        </div>
    </div>
    }

    <!-- Main Glass Header -->
    @if (!hideChrome)
    {
    <header class="main-header-glass sticky-top">
        <div class="container">
            <div class="row align-items-center py-3">
                <div class="col-6 col-md-3 logo-wrapper">
                    <a asp-area="Core" asp-controller="Home" asp-action="Index" class="brand-logo text-decoration-none">
                        <span class="logo-icon"><i class="fas fa-layer-group"></i></span>
                        <span class="logo-text">Ecommerce</span>
                    </a>
                </div>
                <div class="col-12 col-md-6 order-3 order-md-2 mt-3 mt-md-0 search-wrapper">
                    @await Component.InvokeAsync("SearchForm")
                </div>
                <div class="col-6 col-md-3 order-2 order-md-3 d-flex justify-content-end align-items-center cart-wrapper">
                    @await Component.InvokeAsync("CartBadge")
                </div>
            </div>
        </div>

        <!-- Navigation Bar -->
        <div class="nav-glass">
            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-dark p-0">
                    <button class="navbar-toggler ml-auto" type="button" data-toggle="collapse" data-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarMain">
                        @await Component.InvokeAsync("CategoryMenu")
                    </div>
                </nav>
            </div>
        </div>
    </header>
    }

    @if (!hideChrome)
    {
        <partial name="_CookieConsentPartial" />
    }
    
    <main class="@(hideChrome ? "body-content account-login-shell" : "container body-content clearfix flex-grow-1 mt-4 mb-5 position-relative z-index-1")">
        @if (hideChrome)
        {
            @RenderBody()
        }
        else
        {
            <div class="glass-container p-4 p-md-5 rounded-4 shadow-glass">
                @RenderBody()
            </div>
        }
    </main>

    @if (!hideChrome)
    {
    <footer class="footer-glass mt-auto py-5">
        <div class="container position-relative z-index-1">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="footer-brand mb-3">
                        <span class="logo-icon mr-2"><i class="fas fa-layer-group"></i></span>
                        <span class="logo-text h4 text-white mb-0">Ecommerce</span>
                    </div>
                    <p class="text-white-50">The premier, high-performance ecommerce platform built on .NET Core. Experience speed, beauty, and reliability.</p>
                    <div class="social-links mt-4">
                        <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-white mb-4 footer-title">@Localizer["Customer Service"]</h5>
                    <div class="footer-menu">
                        <vc:menu menu-id="1"></vc:menu>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-white mb-4 footer-title">@Localizer["Information"]</h5>
                    <div class="footer-menu">
                        <vc:menu menu-id="2"></vc:menu>
                    </div>
                </div>
            </div>
            <div class="footer-bottom pt-4 mt-4 border-top border-light-50 d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="text-white-50 mb-0">&copy; @DateTime.Now.Year - ECommerce. All rights reserved.</p>
                <p class="text-white-50 mb-0">Powered by <a href="http://www.ECommerce.com" class="text-primary-glass">ECommerce</a></p>
            </div>
        </div>
    </footer>
    }

    <!-- Modals -->
    <div id="shopModal" class="modal fade glass-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content glass-modal-content">
            </div>
        </div>
    </div>
    <div id="productOverview" class="modal fade glass-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content modal-padding glass-modal-content">
            </div>
        </div>
    </div>

    <script>
            window.simplGlobalSetting = {};
            window.simplGlobalSetting.lang = '@CultureInfo.CurrentCulture.Name';
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script simpl-append-version="true" src="~/lib/bootstrap4/js/bootstrap.js"></script>
    <script simpl-append-version="true" src="~/lib/multi-dropdown-menu/js/bootstrap-4-navbar.js"></script>
    <script simpl-append-version="true" src="~/lib/matchheight/jquery.matchHeight.js"></script>
    <script simpl-append-version="true" src="~/lib/toastr/build/toastr.min.js"></script>
    <script simpl-append-version="true" src="~/lib/bootstrap-star-rating/js/star-rating.js"></script>
    <script simpl-append-version="true" src="~/lib/signalr/dist/browser/signalr.js"></script>
    @if(CultureInfo.CurrentCulture.Name != ECommerce.Infrastructure.GlobalConfiguration.DefaultCulture)
    {
        <script simpl-append-version="true" src="~/lib/bootstrap-star-rating/js/locales/@(CultureInfo.CurrentCulture.Name).js"></script>
    }
    <script simpl-append-version="true" src="~/_content/ECommerce.Module.Core/main.js"></script>
    <script simpl-append-version="true" src="~/_content/ECommerce.Module.ShoppingCart/add-to-cart.js"></script>
    <script simpl-append-version="true" src="~/_content/ECommerce.Module.ProductComparison/product-comparison.js"></script>
    <script simpl-append-version="true" src="~/_content/ECommerce.Module.WishList/wishlist.js"></script>
    <script simpl-append-version="true" src="/pwa-register.js"></script>
    <script simpl-append-version="true" src="~/js/button-icons.js"></script>
    @RenderSection("scripts", required: false)

    <partial name="_AnalyticsScript" />
</body>
</html>
